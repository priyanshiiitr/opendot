# Trigger.dev (Development environment API key from dashboard)
# Dashboard → project → Development → API Keys → New key (Trigger only)
TRIGGER_SECRET_KEY=tr_dev_...
# Optional: same secret for Trigger task → FastAPI callback verification
AI_TEAMMATES_TRIGGER_WEBHOOK_SECRET=tr_dev_...
AI_TEAMMATES_CONTROL_PLANE_CALLBACK_URL=http://127.0.0.1:8000/api/internal/durable/execute

