AI_TEAMMATES_MODEL_PROVIDER=mock
# Providers: mock | groq | xai
# Groq Cloud free tier: https://console.groq.com/keys (keys usually start with gsk_)
AI_TEAMMATES_GROQ_API_KEY=
AI_TEAMMATES_GROQ_MODEL=openai/gpt-oss-20b
# xAI / Grok paid API (different product from Groq)
AI_TEAMMATES_XAI_API_KEY=
AI_TEAMMATES_XAI_MODEL=grok-4.6
AI_TEAMMATES_DATABASE_URL=sqlite:///./data/ai_teammates.db
# Milestone 5 — local automation worker (requires backend process running)
AI_TEAMMATES_AUTOMATION_WORKER_ENABLED=true
AI_TEAMMATES_AUTOMATION_DEFAULT_TIMEZONE=Asia/Calcutta
# Milestone 6 — empty uses %LOCALAPPDATA%/AITeammates/computers
AI_TEAMMATES_COMPUTERS_ROOT_DIR=
AI_TEAMMATES_COMPUTER_HEADLESS_DEFAULT=true
# Milestone 10 — computer provider (local_browser | isolated_linux_dev). Never enable billable without approval.
AI_TEAMMATES_COMPUTER_DEFAULT_PROVIDER=local_browser
AI_TEAMMATES_COMPUTER_ALLOW_BILLABLE=false
AI_TEAMMATES_COMPUTER_IDLE_STOP_MINUTES=30
AI_TEAMMATES_COMPUTER_MAX_RUNTIME_MINUTES=240
# Milestone 8 — multi-agent team limits / shared artifact root
AI_TEAMMATES_TEAM_MAX_CONCURRENT=2
AI_TEAMMATES_TEAM_MAX_DEPTH=1
AI_TEAMMATES_TEAM_SHARED_ARTIFACTS_ROOT=./data/team_artifacts
# Milestone 9 — always-on + optional remote companion (OFF by default)
AI_TEAMMATES_BIND_HOST=127.0.0.1
AI_TEAMMATES_BIND_PORT=8000
AI_TEAMMATES_REMOTE_ACCESS_ENABLED=false
AI_TEAMMATES_LOCAL_TRUST_LOOPBACK=true
# When enabling remote access: use a private VPN (e.g. Tailscale), set BIND_HOST to that interface,
# add your companion origin to AI_TEAMMATES_CORS_ORIGINS, then pair from Ops → Companion.
# AI_TEAMMATES_CORS_ORIGINS=http://localhost:5173
# Browser automation. Keep fixture mode false outside automated tests.
AI_TEAMMATES_BROWSER_ENABLED=true
AI_TEAMMATES_BROWSER_HEADLESS=true
AI_TEAMMATES_BROWSER_FIXTURE_MODE=false
AI_TEAMMATES_BROWSER_FIXTURE_PORT=0
AI_TEAMMATES_BROWSER_FIXTURE_BASE_URL=
# Telegram bot tokens are stored in Windows Credential Manager via keyring — never commit them.
# Enter the token only in the Connections UI (not in this file and not in chat).
